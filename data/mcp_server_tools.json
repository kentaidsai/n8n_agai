{
  "_說明": "Module 3 練習用 MCP Server 工具定義與模擬回應範例。可用來建置一個簡易 MCP Server（例如用 Node.js 的 @modelcontextprotocol/sdk 或任何支援 MCP 的框架包裝下列三個工具），供 n8n 的 MCP Client Tool 節點連線呼叫；亦可直接作為工具設計文件參考，理解 MCP tool schema 的撰寫方式。",
  "server_name": "customer-service-mcp-server",
  "server_version": "0.1.0",
  "tools": [
    {
      "name": "get_order_status",
      "description": "查詢訂單狀態，輸入訂單編號，回傳訂單狀態、品項與預計到貨日。查無此訂單時回傳 found=false。",
      "input_schema": {
        "type": "object",
        "properties": {
          "order_id": { "type": "string", "description": "訂單編號，例如 A12345" }
        },
        "required": ["order_id"]
      },
      "mock_examples": [
        {
          "input": { "order_id": "A12345" },
          "output": {
            "found": true,
            "status": "已出貨",
            "eta": "2026-09-25",
            "items": [{ "name": "無線藍牙耳機", "qty": 1 }]
          }
        },
        {
          "input": { "order_id": "A99999" },
          "output": { "found": false, "message": "查無此訂單編號" }
        }
      ]
    },
    {
      "name": "get_inventory",
      "description": "查詢商品庫存數量，輸入商品 SKU，回傳目前可售庫存與補貨預估日。",
      "input_schema": {
        "type": "object",
        "properties": {
          "sku": { "type": "string", "description": "商品 SKU，例如 SKU-1001" }
        },
        "required": ["sku"]
      },
      "mock_examples": [
        {
          "input": { "sku": "SKU-1001" },
          "output": { "sku": "SKU-1001", "name": "無線藍牙耳機", "in_stock": 42, "restock_eta": null }
        },
        {
          "input": { "sku": "SKU-4005" },
          "output": { "sku": "SKU-4005", "name": "27吋螢幕", "in_stock": 0, "restock_eta": "2026-10-05" }
        },
        {
          "input": { "sku": "SKU-9999" },
          "output": { "sku": "SKU-9999", "name": null, "in_stock": null, "restock_eta": null, "error": "查無此商品 SKU" }
        }
      ]
    },
    {
      "name": "search_faq",
      "description": "以自然語言查詢客服知識庫（FAQ），輸入問題關鍵字，回傳最相關的 1～3 筆 FAQ 條目。",
      "input_schema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "顧客問題的關鍵字或原始問句" }
        },
        "required": ["query"]
      },
      "mock_examples": [
        {
          "input": { "query": "退貨要幾天" },
          "output": {
            "results": [
              { "question": "退貨需要多久時間？", "answer": "退貨申請審核約 1～2 個工作天，商品寄回並驗收後 3～5 個工作天內完成退款。" },
              { "question": "退貨運費誰付？", "answer": "商品瑕疵由賣家負擔運費；非瑕疵原因退貨由買家負擔運費。" }
            ]
          }
        },
        {
          "input": { "query": "怎麼取消訂單" },
          "output": {
            "results": [
              { "question": "訂單成立後可以取消嗎？", "answer": "訂單尚未出貨前可在會員中心直接取消；已出貨則須改走退貨流程。" }
            ]
          }
        },
        {
          "input": { "query": "外星人入侵怎麼辦" },
          "output": { "results": [], "message": "知識庫中查無相關資料" }
        }
      ]
    }
  ]
}
